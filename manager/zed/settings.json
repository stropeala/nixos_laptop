{
  // ════════════════════════════════════════════════════════════
  //  Vim Mode
  // ════════════════════════════════════════════════════════════
  "hard_tabs": false,
  "vim_mode": false,
  "vim": {
    "cursor_shape": {
      "normal": "hollow",
    },
    "toggle_relative_line_numbers": true,
  },

  // ════════════════════════════════════════════════════════════
  //  EXTENSIONS — auto-reinstall
  // ════════════════════════════════════════════════════════════
  "auto_install_extensions": {
    // Themes
    "modest-dark": true,
    "nvim-nightfox": true,
    // Icon themes
    "catppuccin-icons": true,
    // Languages / tools
    "basedpyright": true,
    "env": true,
    "fish": true,
    "git-firefly": true,
    "html": true,
    "ini": true,
    "python-refactoring": true,
    "python-requirements": true,
    "sql": true,
    "svelte": true,
    "toml": true,
    "vue": true,
    "nix": true,
    // Snippets
    "python-snippets": true,
    "rust-snippets": false,
    "svelte-snippets": true,
  },

  // ════════════════════════════════════════════════════════════
  //  STARTUP
  // ════════════════════════════════════════════════════════════
  "restore_on_startup": "last_session",

  // ════════════════════════════════════════════════════════════
  //  UI
  // ════════════════════════════════════════════════════════════
  "buffer_line_height": {
    "custom": 1.69,
  },
  "buffer_font_weight": 350.0,
  "buffer_font_family": "JetBrains Mono",
  "theme": "Custom Catppuccin Mocha v3",
  "icon_theme": "Catppuccin Frappé",
  "ui_font_size": 16,
  "buffer_font_size": 22.0,
  "agent_buffer_font_size": 12.0,
  "agent_ui_font_size": 16.0,
  "base_keymap": "JetBrains",
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "sticky_scroll": true,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },

  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "errors",
  },

  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
  },

  "scrollbar": {
    "git_diff": true,
    "diagnostics": "all",
    "selected_symbol": true,
  },

  // ════════════════════════════════════════════════════════════
  //  EDITOR
  // ════════════════════════════════════════════════════════════
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "snippet_sort_order": "top",
  "show_edit_predictions": true,
  "linked_edits": true,
  "auto_signature_help": false,
  "show_signature_help_after_edits": false,
  "use_smartcase_search": true,
  "search": {
    "case_sensitive": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "error",
    },
  },
  "inlay_hints": {
    "enabled": true,
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },

  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "current_line_highlight": "all",
  "selection_highlight": true,
  "auto_indent_on_paste": true,
  "inline_code_actions": true,
  "use_on_type_format": true,

  "cursor_blink": false,
  "confirm_quit": true,
  "auto_update": false,
  "hover_popover_delay": 150,
  "seed_search_query_from_cursor": "selection",
  "scroll_sensitivity": 2.69,
  "scroll_beyond_last_line": "off",
  "vertical_scroll_margin": 5,
  "show_wrap_guides": true,
  "wrap_guides": [100],
  "minimap": {
    "show": "never",
  },

  // ════════════════════════════════════════════════════════════
  //  GIT
  // ════════════════════════════════════════════════════════════
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 200,
      "show_commit_summary": true,
    },
    "hunk_style": "staged_hollow",
  },

  // ════════════════════════════════════════════════════════════
  //  AI / AGENT
  // ════════════════════════════════════════════════════════════
  "disable_ai": false,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",

    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "high",
    },
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "high",
    },
    "thread_summary_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "medium",
    },
    "commit_message_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "medium",
    },
    "subagent_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "medium",
    },

    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "zed.dev",
        "model": "claude-haiku-4-5",
        "enable_thinking": true,
      },
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium",
      },
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "medium",
      },
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-luna",
        "enable_thinking": true,
        "effort": "medium",
      },
    ],

    "model_parameters": [],
  },

  "edit_predictions": {
    "allow_data_collection": "yes",
    "provider": "zed",
    "mode": "eager",
  },

  // ════════════════════════════════════════════════════════════
  //  TERMINAL
  // ════════════════════════════════════════════════════════════
  "terminal": {
    "shell": { "program": "fish" },
    "copy_on_select": true,
    "cursor_shape": "bar",
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
      },
    },
  },

  // ════════════════════════════════════════════════════════════
  //  PRIVACY
  // ════════════════════════════════════════════════════════════
  "proxy": "",
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },

  // ════════════════════════════════════════════════════════════
  //  LANGUAGES
  // ════════════════════════════════════════════════════════════
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": false,
        "show_parameter_hints": true,
        "show_other_hints": false,
      },
    },
    "Rust": {
      "language_servers": ["rust-analyzer"],
      "format_on_save": "on",
      "formatter": "language_server",
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
      },
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": false,
        "show_parameter_hints": true,
        "show_other_hints": false,
      },
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": "prettier",
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": false,
        "show_parameter_hints": true,
        "show_other_hints": false,
      },
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "Svelte": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "Vue.js": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "Go": {
      "format_on_save": "on",
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": false,
        "show_parameter_hints": true,
        "show_other_hints": false,
      },
    },
    "C": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
    "C++": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "TOML": {
      "format_on_save": "on",
    },
  },

  // ════════════════════════════════════════════════════════════
  //  LSP
  // ════════════════════════════════════════════════════════════
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "disableOrganizeImports": true,
        },
        "python": {
          "analysis": {
            "typeCheckingMode": "standard",
            "diagnosticMode": "workspace",
            "useLibraryCodeForTypes": true,
            "autoSearchPaths": true,
            "autoImportCompletions": true,
            "inlayHints": {
              "variableTypes": false,
              "functionReturnTypes": true,
              "parameterTypes": false,
            },
          },
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lint": {
            "enable": true,
          },
          "format": {
            "enable": true,
            "quote-style": "preserve",
          },
        },
      },
    },
    "rust-analyzer": {
      "binary": {
        "path": "/home/lapstrop/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/rust-analyzer",
        "arguments": [],
      },
      "initialization_options": {
        //   "cargo": {
        //     "features": ["hydrate"]
        //   },
        "procMacro": {
          "ignored": {
            "leptos_macro": ["server"],
          },
        },
        "check": {
          "command": "clippy",
        },
        "checkOnSave": true,
        "rust": {
          "analyzerTargetDir": true,
        },
        "inlayHints": {
          "typeHints": { "enable": false },
          "parameterHints": { "enable": true },
          "chainingHints": { "enable": false },
          "closingBraceHints": { "enable": false },
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": { "enable": "always" },
        },
        "imports": {
          "granularity": { "group": "module" },
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "inlayHints": {
            "parameterNames": { "enabled": "literals" },
            "variableTypes": { "enabled": false },
            "functionLikeReturnTypes": { "enabled": true },
          },
        },
      },
    },
    "gopls": {
      "initialization_options": {
        "usePlaceholders": true,
        "staticcheck": true,
        "hints": {
          "parameterNames": true,
          "assignVariableTypes": false,
          "functionTypeParameters": false,
        },
      },
    },
  },
}
